# nginx configuration for the web container.
#
# This file is a TEMPLATE: the nginx image runs envsubst on every file in
# /etc/nginx/templates at start-up and writes the result to
# /etc/nginx/conf.d/default.conf. That is how BACKEND_HOST / BACKEND_PORT from
# docker-compose.yml reach this file without editing it.
#
# The important lesson of Lab 7: the upstream host is the Compose SERVICE NAME
# ("backend"), never "localhost". Inside a container "localhost" is the
# container itself, so a localhost upstream would produce 502 Bad Gateway.
server {
    listen       80;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # Static page + assets (the calculator UI).
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse proxy to the backend service on the Compose network.
    # proxy_pass has no URI part, so the original path (/api/calc) is kept.
    location /api/ {
        proxy_pass         http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_connect_timeout 3s;
        proxy_read_timeout    10s;
    }

    # Health endpoint used by the compose/CI smoke test through port 8080.
    location = /health {
        proxy_pass       http://${BACKEND_HOST}:${BACKEND_PORT}/health;
        proxy_set_header Host $host;
    }
}
